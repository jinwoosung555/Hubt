    MainFrame.Parent = KenHubGUI
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.5, -250, 0.5, -175)
    MainFrame.Size = UDim2.new(0, 500, 0, 350)
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

    local TopBar = Instance.new("Frame")
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    TopBar.BorderSizePixel = 0
    TopBar.Size = UDim2.new(0, 500, 0, 40)
    Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 8)

    local Title = Instance.new("TextLabel")
    Title.Parent = TopBar
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 15, 0, 0)
    Title.Size = UDim2.new(0, 200, 1, 0)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "Ken Hub"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 16
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- Close Button (X)
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Position = UDim2.new(1, -40, 0, 0)
    CloseBtn.Size = UDim2.new(0, 40, 1, 0)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(200, 60, 60)
    CloseBtn.TextSize = 14

    CloseBtn.MouseButton1Click:Connect(function()
        FOVCircle:Remove()
        KenHubGUI:Destroy()
    end)

    -- Minimize Button (-)
    local MinBtn = Instance.new("TextButton")
    MinBtn.Parent = TopBar
    MinBtn.BackgroundTransparency = 1
    MinBtn.Position = UDim2.new(1, -80, 0, 0)
    MinBtn.Size = UDim2.new(0, 40, 1, 0)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.Text = "-"
    MinBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    MinBtn.TextSize = 16

    -- Floating Draggable 'K' Button (Minimized state)
    local FloatBtn = Instance.new("TextButton")
    FloatBtn.Name = "FloatingK"
    FloatBtn.Parent = KenHubGUI
    FloatBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    FloatBtn.Position = UDim2.new(0, 50, 0, 50)
    FloatBtn.Size = UDim2.new(0, 45, 0, 45)
    FloatBtn.Font = Enum.Font.GothamBold
    FloatBtn.Text = "K"
    FloatBtn.TextColor3 = Color3.fromRGB(138, 43, 226)
    FloatBtn.TextSize = 18
    FloatBtn.Visible = false
    Instance.new("UICorner", FloatBtn).CornerRadius = UDim.new(0, 8)

    MinBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        FloatBtn.Visible = true
    end)

    FloatBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        FloatBtn.Visible = false
    end)

    -- Dragging Logic for Floating K Button
    local dragging, dragInput, dragStart, startPos
    FloatBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = FloatBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            FloatBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Sidebar = Instance.new("Frame")
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundTransparency = 1
    Sidebar.Position = UDim2.new(0, 0, 0, 45)
    Sidebar.Size = UDim2.new(0, 130, 1, -45)

    local ContentArea = Instance.new("Frame")
    ContentArea.Parent = MainFrame
    ContentArea.BackgroundTransparency = 1
    ContentArea.Position = UDim2.new(0, 140, 0, 45)
    ContentArea.Size = UDim2.new(0, 350, 1, -55)

    local function CreateTabButton(name, yPos)
        local btn = Instance.new("TextButton")
        btn.Parent = Sidebar
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        btn.BorderSizePixel = 0
        btn.Position = UDim2.new(0, 10, 0, yPos)
        btn.Size = UDim2.new(0, 110, 0, 30)
        btn.Font = Enum.Font.GothamMedium
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.TextSize = 13
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        return btn
    end

    local function CreateTabContent()
        local frame = Instance.new("ScrollingFrame")
        frame.Parent = ContentArea
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.CanvasSize = UDim2.new(0, 0, 0, 450)
        frame.ScrollBarThickness = 4
        frame.Visible = false
        return frame
    end

    local AimTabBtn = CreateTabButton("Combat", 10)
    local PlayerTabBtn = CreateTabButton("Player Mods", 50)
    local CreditsTabBtn = CreateTabButton("Credits", 90)

    local AimTab = CreateTabContent()
    local PlayerTab = CreateTabContent()
    local CreditsTab = CreateTabContent()
    AimTab.Visible = true

    AimTabBtn.MouseButton1Click:Connect(function()
        AimTab.Visible = true; PlayerTab.Visible = false; CreditsTab.Visible = false
    end)
    PlayerTabBtn.MouseButton1Click:Connect(function()
        AimTab.Visible = false; PlayerTab.Visible = true; CreditsTab.Visible = false
    end)
    CreditsTabBtn.MouseButton1Click:Connect(function()
        AimTab.Visible = false; PlayerTab.Visible = false; CreditsTab.Visible = true
    end)

    local function CreateToggle(parent, text, callback, y)
        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        btn.Position = UDim2.new(0, 0, 0, y)
        btn.Size = UDim2.new(0, 340, 0, 35)
        btn.Font = Enum.Font.GothamMedium
        btn.Text = "  " .. text .. ": [OFF]"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        
        local state = false
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.Text = "  " .. text .. ": " .. (state and "[ON]" or "[OFF]")
            callback(state)
        end)
    end

    local function CreateSlider(parent, text, min, max, default, callback, y)
        local container = Instance.new("Frame")
        container.Parent = parent
        container.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        container.Position = UDim2.new(0, 0, 0, y)
        container.Size = UDim2.new(0, 340, 0, 45)
        Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel")
        label.Parent = container
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 10, 0, 5)
        label.Size = UDim2.new(1, -20, 0, 20)
        label.Font = Enum.Font.GothamMedium
        label.Text = text .. ": " .. default
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left

        local sliderBar = Instance.new("TextButton")
        sliderBar.Parent = container
        sliderBar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        sliderBar.Position = UDim2.new(0, 10, 0, 30)
        sliderBar.Size = UDim2.new(1, -20, 0, 6)
        sliderBar.AutoButtonColor = false
        sliderBar.Text = ""
        Instance.new("UICorner", sliderBar).CornerRadius = UDim.new(0, 3)

        local fill = Instance.new("Frame")
        fill.Parent = sliderBar
        fill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        fill.BorderSizePixel = 0
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

        local draggingSlider = false
        sliderBar.MouseButton1Down:Connect(function() draggingSlider = true end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local mousePos = UserInputService:GetMouseLocation()
                local absPos = sliderBar.AbsolutePosition
                local absSize = sliderBar.AbsoluteSize
                local percentage = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
                local value = math.floor(min + (max - min) * percentage)
                fill.Size = UDim2.new(percentage, 0, 1, 0)
                label.Text = text .. ": " .. value
                callback(value)
            end
        end)
    end

    CreateToggle(AimTab, "Player Aimbot", function(state) Config.PlayerAimbot = state end, 10)
    CreateToggle(AimTab, "NPC Aimbot", function(state) Config.NPCAimbot = state end, 55)
    CreateToggle(AimTab, "FOV Circle", function(state) Config.FOVEnabled = state end, 100)
    CreateSlider(AimTab, "FOV Size", 10, 400, 100, function(val) Config.FOVSize = val end, 145)
    CreateSlider(AimTab, "Aimbot Distance", 100, 10000, 1000, function(val) Config.AimbotDistance = val end, 200)

    CreateToggle(PlayerTab, "Speed Boost", function(state) Config.SpeedBoost = state end, 10)
    CreateToggle(PlayerTab, "Jump Boost", function(state) Config.JumpBoost = state end, 55)

    local function CreateCreditCard(parent, name, role, y)
        local card = Instance.new("Frame")
        card.Parent = parent
        card.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        card.Position = UDim2.new(0, 0, 0, y)
        card.Size = UDim2.new(0, 340, 0, 50)
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
        
        local n = Instance.new("TextLabel")
        n.Parent = card
        n.BackgroundTransparency = 1
        n.Position = UDim2.new(0, 15, 0, 5)
        n.Size = UDim2.new(0, 300, 0, 20)
        n.Font = Enum.Font.GothamBold
        n.Text = name
        n.TextColor3 = Color3.fromRGB(255, 255, 255)
        n.TextSize = 14
        n.TextXAlignment = Enum.TextXAlignment.Left
        
        local r = Instance.new("TextLabel")
        r.Parent = card
        r.BackgroundTransparency = 1
        r.Position = UDim2.new(0, 15, 0, 25)
        r.Size = UDim2.new(0, 300, 0, 20)
        r.Font = Enum.Font.Gotham
        r.Text = role
        r.TextColor3 = Color3.fromRGB(150, 150, 150)
        r.TextSize, r.TextXAlignment = 12, Enum.TextXAlignment.Left
    end

    CreateCreditCard(CreditsTab, "Jinwoo", "Main Scripter", 10)
    CreateCreditCard(CreditsTab, "KENzoro", "Contributor", 70)
    CreateCreditCard(CreditsTab, "Ayla", "Contributor", 130)
end

-- 3. Core Engine Loop (Aimbot, FOV, & Character Tweaks)
RunService.RenderStepped:Connect(function()
    if not verified then return end

    local mouse = LocalPlayer:GetMouse()

    -- FOV Update
    if Config.FOVEnabled then
        FOVCircle.Visible = true
        FOVCircle.Radius = Config.FOVSize
        FOVCircle.Position = Vector2.new(mouse.X, mouse.Y + 36) -- Account for standard topbar offset
    else
        FOVCircle.Visible = false
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        if Config.SpeedBoost then humanoid.WalkSpeed = Config.SpeedValue end
        if Config.JumpBoost then humanoid.JumpPower = Config.JumpValue end
    end

    local target = nil
    local shortestDist = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if Config.PlayerAimbot then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and myRoot then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                local head = char.Head
                if humanoid and humanoid.Health > 0 then
                    local worldDist = (myRoot.Position - head.Position).Magnitude
                    if worldDist <= Config.AimbotDistance then
                        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(headPos.X, headPos.Y)).Magnitude
                            if (not Config.FOVEnabled or screenDist <= Config.FOVSize) and screenDist < shortestDist then
                                shortestDist = screenDist
                                target = head
                            end
                        end
                    end
                end
            end
        end
    elseif Config.NPCAimbot then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") and myRoot then
                if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                    local head = obj.Head
                    local worldDist = (myRoot.Position - head.Position).Magnitude
                    if worldDist <= Config.AimbotDistance then
                        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(headPos.X, headPos.Y)).Magnitude
                            if (not Config.FOVEnabled or screenDist <= Config.FOVSize) and screenDist < shortestDist then
                                shortestDist = screenDist
                                target = head
                            end
                        end
                    end
                end
            end
        end
    end

    if target then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
    end
end)
